# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# ── Supabase (Project Settings → API) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── GitHub App (Developer settings → GitHub Apps) ───
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents; newlines may be written as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Stripe ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time $29 price and $19.99/month recurring price
STRIPE_PRICE_AUDIT=
STRIPE_PRICE_PRO=

# ── Anthropic ────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: claude-haiku-5-5 / claude-sonnet-5-5)
CLAUDE_TRIAGE_MODEL=
CLAUDE_WRITEUP_MODEL=
# Platform-wide AI spend ceiling per UTC day, in USD
DAILY_AI_SPEND_CAP_USD=25

# ── Trigger.dev ──────────────────────────────────────
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# ── Security ─────────────────────────────────────────
# 32+ random characters: openssl rand -base64 48
STATE_SIGNING_SECRET=

# ── Sentry (optional) ────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
